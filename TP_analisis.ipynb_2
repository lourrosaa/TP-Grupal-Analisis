        "df.shape #cuenta filas y columnas\n",
        "print(df.shape)\n",
        "df.dtypes #tipo de dato por columna\n",
        "print(df.dtypes)\n",
        "df.isnull().sum() #filas repetidas\n",
        "print(df.isnull().sum())"
      ]
    },
